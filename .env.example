APP_NAME=ModelHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8094

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=modelhub
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="${MAIL_FROM_ADDRESS}"

# Legal pages (Terms, Privacy). Confirm these with the business owner before launch.
LEGAL_ENTITY_NAME="${APP_NAME}"
LEGAL_EMAIL="${MAIL_SUPPORT_ADDRESS}"
LEGAL_JURISDICTION=Kenya
LEGAL_EFFECTIVE_DATE=2026-10-01

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker / Sail
APP_PORT=8094
WWWUSER=1000
WWWGROUP=1000
FORWARD_DB_PORT=3311
FORWARD_REDIS_PORT=6384
FORWARD_MAILPIT_PORT=52028
FORWARD_MAILPIT_DASHBOARD_PORT=8029
FORWARD_PHPMYADMIN_PORT=8093

# Models marketplace. Files are private; use an S3-compatible disk in production (see config/filesystems.php).
MARKETPLACE_FILES_DISK=local
MARKETPLACE_IMAGES_DISK=public
MARKETPLACE_MAX_FILE_MB=50
MARKETPLACE_PURCHASES_ENABLED=false

# Taking payments. "fake" simulates M-Pesa (a phone number ending 1 = insufficient funds, 2 = cancelled, 3 = times out, 0 = refused,
# anything else pays) and refuses to run in production. Purchases stay closed until MARKETPLACE_PURCHASES_ENABLED is true.
PAYMENTS_GATEWAY=fake
# Money going out (withdrawals): "fake" for now (a number ending 0 is refused, 1 fails, anything else is paid)
PAYMENTS_PAYOUT_GATEWAY=fake
PAYMENTS_FAKE_DELAY=3
PAYMENTS_PENDING_MINUTES=5
PAYMENTS_MAX_KES=150000

# Real M-Pesa (Daraja) through godiah/laravel-common. Leave PAYMENTS_GATEWAY / PAYMENTS_PAYOUT_GATEWAY on "fake" until you have credentials.
# PAYMENTS_GATEWAY=daraja
# PAYMENTS_PAYOUT_GATEWAY=daraja
# PAYMENTS_DARAJA_CALLBACK_SECRET=            # 16+ random characters; goes in the callback URLs given to Safaricom
# PAYMENTS_PAYOUT_STALE_HOURS=6               # staff are told about a withdrawal M-Pesa has not confirmed after this long
# MPESA_ENVIRONMENT=sandbox                   # or production
# MPESA_SANDBOX_CONSUMER_KEY=
# MPESA_SANDBOX_CONSUMER_SECRET=
# MPESA_SANDBOX_BUSINESS_SHORT_CODE=174379
# MPESA_SANDBOX_PASSKEY=
# MPESA_SANDBOX_INITIATOR_NAME=               # B2C: the API operator created on the M-Pesa portal
# MPESA_SANDBOX_SECURITY_CREDENTIAL=          # B2C: initiator password encrypted with Safaricom's certificate (SecurityCredential::fromPassword)
# MPESA_PRODUCTION_CONSUMER_KEY= (and _CONSUMER_SECRET, _BUSINESS_SHORT_CODE, _PASSKEY, _INITIATOR_NAME, _SECURITY_CREDENTIAL)
# MPESA_CACHE_STORE=redis

# Job escrow: a freelancer's accepted offer waits for the client to fund it by M-Pesa; approved deliverables release money. Turn on only when real M-Pesa is live.
# JOBS_ESCROW_ENABLED=false
# PAYMENTS_ESCROW_CANCEL_WINDOW_DAYS=7        # after a client cancels, how long they can still pay for work done before what is left goes back to them


# Support assistant: scripted visual preview of the chat widget (local only; no backend)
SUPPORT_UI_PREVIEW=false
